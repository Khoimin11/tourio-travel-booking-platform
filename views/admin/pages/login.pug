extends ../layouts/account.pug

block main
  .form-account
    h2.inner-title Đăng nhập
    p.inner-desc Vui lòng nhập email và mật khẩu để tiếp tục
    
    form.inner-form#login-form
      .inner-group
        label(
          class="inner-label"
          for="email"
        ) Email
        input(
          type="email"
          name="email"
          id="email"
          placeholder="Ví dụ: levana@gmail.com"
          class="inner-control"
        )
      .inner-group
        label(
          class="inner-label"
          for="password"
        ) Mật khẩu
        .inner-password
          input(
            type="password"
            name="password"
            id="password"
            class="inner-control"
            autocomplete="current-password"
          )
          button.inner-password-toggle(
            type="button"
            password-toggle
            aria-label="Hiện mật khẩu"
            aria-controls="password"
            aria-pressed="false"
            title="Hiện mật khẩu"
          )
            svg(width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
              path(d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z")
              circle(cx="12" cy="12" r="3")
              path.inner-eye-slash(d="M3 3l18 18")
      .inner-meta
        .inner-confirm
          input(
            type="checkbox"
            name="rememberPassword"
            id="remember-password"
            class="inner-check"
          )
          label(
            class="inner-label"
            for="remember-password"
          ) Nhớ mật khẩu
        a(
          href=`/${pathAdmin}/account/forgot-password` 
          class="inner-forgot-password"
        ) Quên mật khẩu?
      button(class="inner-button") Đăng Nhập
    
    .inner-more
      span Bạn chưa có tài khoản?
      a(
        href=`/${pathAdmin}/account/register`
      ) Tạo tài khoản
