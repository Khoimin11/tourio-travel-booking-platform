extends ../layouts/default.pug

block main
  h1.box-title Thùng rác đơn hàng

  .admin-toolbar.admin-toolbar-orders
    //- Section 4
    .section-4.admin-filters(style="--filter-span: 4")
      .inner-wrap
        .inner-item
          select(filter-status)
            option(value="" disabled hidden selected) Trạng thái
            each item in orderStatusList
              option(value=item.value) #{item.label}
        .inner-item
          select(filter-payment-method)
            option(value="" disabled hidden selected) Phương thức thanh toán
            each item in paymentMethodList
              option(value=item.value) #{item.label}
        .inner-item
          select(filter-payment-status)
            option(value="" disabled hidden selected) Trạng thái thanh toán
            each item in paymentStatusList
              option(value=item.value) #{item.label}
        .inner-item.inner-date
          label
            span Từ ngày
            input(type="date" filter-start-date)
          span.date-separator –
          label
            span Đến ngày
            input(type="date" filter-end-date)
        button.inner-item.inner-reset(type="button" filter-reset)
          <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
    //- End Section 4

    //- Section 5
    .section-5
      .inner-wrap
        .inner-change-status(change-multi data-api=`/${pathAdmin}/order/trash/change-multi`)
          .inner-item
            select(aria-label="Hành động cho đơn hàng đã chọn")
              option(value="" disabled hidden selected) -- Hành động --
              option(value="undo") Khôi phục
              option(value="delete-destroy") Xóa vĩnh viễn
          .inner-item
            button(type="button") Áp dụng
        .inner-search
          <i class="fa-solid fa-magnifying-glass"></i>
          input(type="text" placeholder="Tìm kiếm" search)
    //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th(class="inner-center" style="width: 60px")
              input(type="checkbox" class="inner-check" check-all aria-label="Chọn tất cả đơn hàng trên trang")
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th(class="inner-center") Ngày đặt
            th Hành động
        tbody
          each orderDetail in orderList
            tr
              td(class="inner-center")
                input(type="checkbox" class="inner-check" check-item=orderDetail.id aria-label=`Chọn đơn hàng ${orderDetail.orderCode}`)
              td
                .inner-code #{orderDetail.orderCode}
              td
                div Họ tên: #{orderDetail.fullName}
                div SĐT: #{orderDetail.phone}
                div Ghi chú: #{orderDetail.note}
              td
                each item in orderDetail.items
                  .inner-item
                    .inner-image
                      img(src=item.avatar, alt=item.name)
                    .inner-content
                      .inner-name #{item.name}
                      .inner-quantity Người lớn: #{item.quantityAdult} x #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                      .inner-quantity Trẻ em: #{item.quantityChildren} x #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                      .inner-quantity Em bé: #{item.quantityBaby} x #{item.priceNewBaby.toLocaleString("vi-VN")}đ
              td
                div Tạm tính: #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
                div Giảm: #{orderDetail.discount.toLocaleString("vi-VN")}đ
                div Thanh toán: #{orderDetail.total.toLocaleString("vi-VN")}đ
                div PTTT: #{orderDetail.paymentMethodName}
                div TTTT: #{orderDetail.paymentStatusName}
              td
                if (orderDetail.status == "initial")
                  .badge.badge-orange #{orderDetail.statusName}
                else if (orderDetail.status == "done")
                  .badge.badge-green #{orderDetail.statusName}
                else if (orderDetail.status == "cancel")
                  .badge.badge-red #{orderDetail.statusName}
              td(class="inner-center")
                div #{orderDetail.createdAtTime}
                div #{orderDetail.createdAtDate}
              td
                .inner-buttons
                  button(
                    type="button"
                    class="inner-edit"
                    title="Khôi phục đơn hàng"
                    aria-label="Khôi phục đơn hàng"
                    button-undo
                    data-api=`/${pathAdmin}/order/undo/${orderDetail.id}`
                  ) <i class="fa-solid fa-rotate-left"></i>
                  button(
                    type="button"
                    class="inner-delete"
                    title="Xóa vĩnh viễn"
                    aria-label="Xóa vĩnh viễn đơn hàng"
                    button-delete
                    data-confirm="Xóa vĩnh viễn đơn hàng này? Thao tác này không thể hoàn tác."
                    data-api=`/${pathAdmin}/order/delete-destroy/${orderDetail.id}`
                  ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  .section-7
    - const startRecord = pagination.totalRecord > 0 ? pagination.skip + 1 : 0
    - const endRecord = pagination.skip + orderList.length
    span(class="inner-label") Hiển thị #{startRecord} - #{endRecord} của #{pagination.totalRecord}
    if pagination.totalPage > 0
      select(class="inner-pagination" pagination)
        - for (let i = 1; i <= pagination.totalPage; i++)
          option(value=i, selected=(i === pagination.currentPage)) Trang #{i}
  //- End Section 7
