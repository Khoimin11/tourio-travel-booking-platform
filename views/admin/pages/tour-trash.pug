extends ../layouts/default.pug

block main
  if (permissions.includes("tour-view"))
    h1.box-title Thùng rác tour

    .admin-toolbar
      //- Section 4
      .section-4.admin-filters
        .inner-wrap
          .inner-item
            select(filter-status)
              option(value="") Trạng thái
              option(value="active") Hoạt động
              option(value="inactive") Tạm dừng
          .inner-item
            select(filter-created-by)
              option(value="") Người tạo
              each item in accountAdminList
                option(value=item.id) #{item.fullName}
          .inner-item
            select(filter-category)
              option(value="") Danh mục
              each item in categoryList
                option(value=item.id) #{item.name}
          .inner-item
            select(filter-price-range)
              option(value="") Mức giá
              option(value="under-2000000") Dưới 2tr
              option(value="2000000-4000000") 2tr đến 4tr
              option(value="4000000-8000000") 4tr đến 8tr
              option(value="over-8000000") Trên 8tr
          .inner-item.inner-date
            label
              span Từ ngày
              input(type="date" filter-start-date)
            span.date-separator –
            label
              span Đến ngày
              input(type="date" filter-end-date)
          button.inner-item.inner-reset(type="button" filter-reset)
            <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
      //- End Section 4

      //- Section 5
      .section-5
        .inner-wrap
          .inner-change-status(change-multi data-api=`/${pathAdmin}/tour/trash/change-multi`)
            .inner-item
              select
                option(value="") -- Hành động --
                if (permissions.includes("tour-trash"))
                  option(value="undo") Khôi phục
                  option(value="delete-destroy") Xóa vĩnh viễn
            .inner-item
              button Áp dụng
          .inner-search
            <i class="fa-solid fa-magnifying-glass"></i>
            input(type="text" placeholder="Tìm kiếm" search)
      //- End Section 5

    //- Section 6
    .section-6
      .table-2
        table
          thead
            tr
              th(class="inner-center")
                input(type="checkbox" class="inner-check" check-all)
              th Tên tour
              th(style="width: 120px") Ảnh đại diện
              th(style="width: 140px") Giá
              th(style="width: 80px") Còn lại
              th(class="inner-center" style="width: 70px") Vị trí
              th(class="inner-center") Trạng thái
              th Tạo bởi
              th Cập nhật bởi
              th Hành động
          tbody
            each item in tourList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=item.id)
                td #{item.name}
                td
                  img(src=item.avatar class="inner-avatar")
                td
                  div NL: #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                  div TE: #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                  div EB: #{item.priceNewBaby.toLocaleString("vi-VN")}đ
                td
                  div NL: #{item.stockAdult}
                  div TE: #{item.stockChildren}
                  div EB: #{item.stockBaby}
                td(class="inner-center") #{item.position}
                td(class="inner-center")
                  if (item.status == "active")
                    .badge.badge-green Hoạt động
                  else if (item.status == "inactive")
                    .badge.badge-red Tạm dừng
                td
                  div #{item.createdByFullName}
                  div.inner-time #{item.createdAtFormat}
                td
                  div #{item.updatedByFullName}
                  div.inner-time #{item.updatedAtFormat}
                td
                  .inner-buttons
                    if (permissions.includes("tour-trash"))
                      button(
                        type="button"
                        class="inner-edit"
                        title="Khôi phục tour"
                        aria-label="Khôi phục tour"
                        button-undo
                        data-api=`/${pathAdmin}/tour/undo/${item.id}`
                      ) <i class="fa-solid fa-rotate-left"></i>
                      button(
                        type="button"
                        class="inner-delete"
                        title="Xóa vĩnh viễn"
                        aria-label="Xóa vĩnh viễn tour"
                        button-delete
                        data-confirm="Xóa vĩnh viễn tour này? Thao tác này không thể hoàn tác."
                        data-api=`/${pathAdmin}/tour/delete-destroy/${item.id}`
                      ) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

    //- Section 7
    .section-7
      - const startRecord = pagination.totalRecord > 0 ? pagination.skip + 1 : 0
      - const endRecord = pagination.skip + tourList.length
      span(class="inner-label") Hiển thị #{startRecord} - #{endRecord} của #{pagination.totalRecord}
      if pagination.totalPage > 0
        select(class="inner-pagination" pagination)
          - for (let i = 1; i <= pagination.totalPage; i++)
            option(value=i, selected=(i === pagination.currentPage)) Trang #{i}
    //- End Section 7
