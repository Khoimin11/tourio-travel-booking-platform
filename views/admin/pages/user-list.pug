extends ../layouts/default.pug

block main
  h1.box-title Quản lý quản trị viên

  //- Section 4
  .section-4
    .inner-wrap
      .inner-item.inner-label
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select(filter-status)
          option(value="") Trạng thái
          option(value="active") Hoạt động
          option(value="inactive") Tạm dừng
      .inner-item.inner-date
        input(type="date" filter-start-date)
        span -
        input(type="date" filter-end-date)
      .inner-item.inner-reset(filter-reset)
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5
    .inner-wrap
      .inner-change-status
        .inner-item
          select
            option(value="") -- Hành động --
            option(value="") Hoạt động
            option(value="") Dừng hoạt động
            option(value="") Xóa
        .inner-item
          button Áp dụng
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm" search)
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th(class="inner-center")
              input(type="checkbox" class="inner-check")
            th Họ tên
            th(class="inner-center") Ảnh đại diện
            th Email
            th Số điện thoại
            th Vị trí công ty
            th Trạng thái
            th Hành động
        tbody
          each item in userList
            tr
              td(class="inner-center")
                input(type="checkbox" class="inner-check")
              td #{item.fullName}
              td(class="inner-center")
                img(src=(item.avatar || "/admin/assets/images/avatar.jpg") class="inner-avatar")
              td #{item.email}
              td #{item.phone}
              td #{item.positionCompany}
              td
                if (item.status == "active")
                  .badge.badge-green Hoạt động
                else if (item.status == "inactive")
                  .badge.badge-red Tạm dừng
              td
                .inner-buttons
                  a(class="inner-edit" href=`/${pathAdmin}/user/edit/${item.id}` title="Chỉnh sửa quản trị viên" aria-label="Chỉnh sửa quản trị viên") <i class="fa-regular fa-pen-to-square"></i>
                  button(
                    type="button"
                    class="inner-delete"
                    title="Xóa quản trị viên"
                    aria-label="Xóa quản trị viên"
                    button-delete
                    data-api=`/${pathAdmin}/user/delete/${item.id}`
                    data-confirm="Bạn có chắc muốn xóa quản trị viên này?"
                  ) <i class="fa-regular fa-trash-can"></i>
  //- End Section 6

  //- Section 7
  .section-7
    - const startRecord = pagination.totalRecord > 0 ? pagination.skip + 1 : 0
    - const endRecord = pagination.skip + userList.length
    span(class="inner-label") Hiển thị #{startRecord} - #{endRecord} của #{pagination.totalRecord}
    if pagination.totalPage > 0
      select(class="inner-pagination" pagination)
        - for (let i = 1; i <= pagination.totalPage; i++)
          option(value=i, selected=(i === pagination.currentPage)) Trang #{i}
  //- End Section 7
